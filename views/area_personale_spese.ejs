<%- include('partials/header') %>
<nav class="breadcrumb-bar">Sei in: <a href="/home">Home</a> <span class="sep">›</span> <a href="/area-personale">Area Personale</a> <span class="sep">›</span> <strong>Spese</strong></nav>
<h1 class="page-title">💶 Le Mie Spese</h1>

<div class="alert alert-info">
  ℹ️ Le spese restano sempre consultabili qui, anche cambiando l'edizione attiva del portale.
  Usa il menu sotto per navigare tra gli anni in cui hai sostenuto spese.
</div>

<div class="pill-tabs">
  <a class="pill-tab <%= selectedEdition === 'tutte' ? 'active' : '' %>" href="/area-personale/spese?edizione=tutte">Tutte</a>
  <% editions.forEach(function(e){ %>
    <a class="pill-tab <%= String(selectedEdition) === String(e.id) ? 'active' : '' %>" href="/area-personale/spese?edizione=<%= e.id %>"><%= e.name || e.year %></a>
  <% }); %>
</div>

<div style="display:flex;gap:.6rem;margin-bottom:1rem;flex-wrap:wrap;align-items:center;">
  <button class="primary" onclick="document.getElementById('modal-new-expense').style.display='flex'">➕ Nuova spesa</button>
  <a class="secondary" href="/area-personale/spese/export.csv?edizione=<%= selectedEdition %>">⬇️ Esporta CSV</a>
  <span class="chip" style="margin-left:auto;font-size:.85rem;">Totale: € <%= totalAmount.toFixed(2) %></span>
  <% if (unassignedCount > 0) { %>
    <a class="primary" href="/area-personale/richieste-rimborso">💰 Richiedi rimborso (<%= unassignedCount %> spese disponibili)</a>
  <% } %>
</div>

<div class="table-wrapper">
  <table>
    <thead><tr><th>Data</th><th>Descrizione</th><th>Categoria</th><th>Edizione</th><th>Importo</th><th>Ricevute</th><th>Stato</th><th></th></tr></thead>
    <tbody>
      <% expenses.forEach(function(e){ %>
      <tr>
        <td><%= e.expense_date %></td>
        <td><%= e.description %></td>
        <td><span class="chip"><%= e.category || '—' %></span></td>
        <td><%= e.edition_name || '—' %></td>
        <td>€ <%= e.amount.toFixed(2) %></td>
        <td><%= e.receipt_count || 0 %></td>
        <!-- FIX bug #2: era <%= %> (HTML-escape) invece di <%- %> -> mostrava il tag come testo letterale -->
        <td><%- e.refund_request_id ? '<span class="chip">In richiesta rimborso</span>' : '<span class="chip">Disponibile</span>' %></td>
        <td style="white-space:nowrap;">
          <button class="secondary" style="padding:.25rem .6rem;font-size:.72rem;" onclick="openExpenseModal(<%= e.id %>)">🔍 Consulta</button>
          <% if (!e.refund_request_id) { %>
            <form method="POST" action="/area-personale/spese/<%= e.id %>/elimina" style="display:inline;" onsubmit="return confirm('Eliminare questa spesa?')">
              <button type="submit" class="btn-danger">🗑️</button>
            </form>
          <% } %>
        </td>
      </tr>
      <% }); %>
      <% if (!expenses.length) { %><tr><td colspan="8" class="help-text">Nessuna spesa registrata.</td></tr><% } %>
    </tbody>
  </table>
</div>

<div class="modal-overlay" id="modal-new-expense">
  <div class="modal">
    <div class="modal-header"><h2>➕ Nuova spesa</h2><button class="modal-close" onclick="document.getElementById('modal-new-expense').style.display='none'">✕</button></div>
    <form method="POST" action="/area-personale/spese" enctype="multipart/form-data">
      <div class="modal-body">
        <label>Descrizione <span class="req">*</span><input type="text" name="description" required maxlength="200"></label>
        <label>Importo (EUR) <span class="req">*</span><input type="number" name="amount" step="0.01" min="0" required></label>
        <label>Data <span class="req">*</span><input type="date" name="expense_date" required></label>
        <label>Categoria <input type="text" name="category" maxlength="60" placeholder="es. carburante, materiali, vitto..."></label>
        <label>Note <textarea name="notes" rows="2"></textarea></label>
        <label>Ricevute (foto scontrino o PDF fattura — max 5 file, 12MB ciascuno)
          <input type="file" name="receipts" multiple accept="application/pdf,image/jpeg,image/png,image/heic,image/webp">
        </label>
      </div>
      <div class="modal-actions" style="padding:0 1.2rem 1.2rem;">
        <button type="button" class="secondary" onclick="document.getElementById('modal-new-expense').style.display='none'">Annulla</button>
        <button type="submit" class="primary">Salva spesa</button>
      </div>
    </form>
  </div>
</div>

<!-- FIX bug #2: popup "Consulta spesa" con info, note e anteprima allegati senza scaricarli -->
<div class="modal-overlay" id="modal-view-expense">
  <div class="modal" style="max-width:640px;">
    <div class="modal-header"><h2>🔍 Dettaglio spesa</h2><button class="modal-close" onclick="document.getElementById('modal-view-expense').style.display='none'">✕</button></div>
    <div class="modal-body" id="expense-detail-body">
      <p class="help-text">Caricamento...</p>
    </div>
  </div>
</div>

<script>
function openExpenseModal(id){
  var body = document.getElementById('expense-detail-body');
  body.innerHTML = '<p class="help-text">Caricamento...</p>';
  document.getElementById('modal-view-expense').style.display = 'flex';
  fetch('/api/area-personale/spese/' + id)
    .then(function(r){ return r.json(); })
    .then(function(data){
      var e = data.expense, receipts = data.receipts || [];
      var html = '<table style="width:100%;font-size:.88rem;margin-bottom:1rem;">' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;width:120px;">Data</td><td>' + e.expense_date + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Descrizione</td><td>' + escH(e.description) + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Categoria</td><td>' + escH(e.category || '—') + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Importo</td><td><strong>€ ' + e.amount.toFixed(2) + '</strong></td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Edizione</td><td>' + escH(e.edition_name || '—') + '</td></tr>' +
        (e.notes ? '<tr><td style="color:var(--text-muted);padding:.25rem 0;vertical-align:top;">Note</td><td>' + escH(e.notes) + '</td></tr>' : '') +
        '</table>';
      html += '<h3 style="margin-top:0;">Allegati (' + receipts.length + ')</h3>';
      if (!receipts.length) {
        html += '<p class="help-text">Nessuna ricevuta allegata.</p>';
      } else {
        receipts.forEach(function(r){
          html += '<div style="margin-bottom:.9rem;padding:.6rem;border:1px solid var(--border-light);border-radius:8px;">';
          html += '<div style="font-size:.8rem;font-weight:700;margin-bottom:.4rem;">' + escH(r.original_name) + '</div>';
          if (r.is_image) {
            html += '<img src="' + r.view_url + '" style="max-width:100%;max-height:320px;border-radius:6px;display:block;">';
          } else if (r.is_pdf) {
            html += '<iframe src="' + r.view_url + '" style="width:100%;height:360px;border:1px solid var(--border-light);border-radius:6px;"></iframe>';
          } else {
            html += '<a href="' + r.view_url + '" target="_blank" class="link-action">Apri allegato</a>';
          }
          html += '</div>';
        });
      }
      document.getElementById('expense-detail-body').innerHTML = html;
    })
    .catch(function(){ body.innerHTML = '<p class="help-text">Errore nel caricamento della spesa.</p>'; });
}
function escH(s){ if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }
</script>

<%- include('partials/footer') %>
