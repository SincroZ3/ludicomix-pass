<% if (currentUser) { %>
<!-- COMMAND PALETTE -->
<div id="cp-overlay" role="dialog" aria-modal="true" aria-label="Ricerca rapida">
  <div id="cp-box">
    <div id="cp-header">
      <span style="font-size:1.1rem;opacity:.5">🔍</span>
      <input id="cp-q" type="text" placeholder="Cerca partecipanti, pass, gruppi…" autocomplete="off" spellcheck="false">
      <span id="cp-hint"><kbd>ESC</kbd> chiude</span>
    </div>
    <div id="cp-results"><div class="cp-empty">Inizia a digitare…</div></div>
    <div class="cp-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> naviga</span>
      <span><kbd>↵</kbd> apri</span>
      <span><kbd>Ctrl</kbd>+<kbd>K</kbd> apri/chiudi</span>
      <span style="margin-left:auto"><a href="/search" style="color:#a0aec0;text-decoration:none;font-size:.72rem">Ricerca avanzata →</a></span>
    </div>
  </div>
</div>

<!-- FAB ricerca mobile -->
<button id="search-fab" aria-label="Apri ricerca rapida" title="Cerca (Cmd+K)">🔍</button>
<script>
(function(){
  var overlay=document.getElementById('cp-overlay');
  var input=document.getElementById('cp-q');
  var resultsEl=document.getElementById('cp-results');
  var timer=null, focusIdx=-1, items=[];

  function open(){overlay.classList.add('open');input.value='';renderEmpty();setTimeout(function(){input.focus();},10);}
  function close(){overlay.classList.remove('open');focusIdx=-1;}
  function renderEmpty(){resultsEl.innerHTML='<div class="cp-empty">Inizia a digitare…</div>';}
  function renderLoading(){resultsEl.innerHTML='<div class="cp-empty">Ricerca in corso…</div>';}

  document.addEventListener('keydown',function(e){
    if((e.ctrlKey||e.metaKey)&&e.key==='k'){e.preventDefault();overlay.classList.contains('open')?close():open();return;}
    if(!overlay.classList.contains('open'))return;
    if(e.key==='Escape'){close();return;}
    if(e.key==='ArrowDown'){e.preventDefault();moveFocus(1);return;}
    if(e.key==='ArrowUp'){e.preventDefault();moveFocus(-1);return;}
    if(e.key==='Enter'){e.preventDefault();activateFocused();return;}
  });

  overlay.addEventListener('click',function(e){if(e.target===overlay)close();});

  function moveFocus(d){
    items=resultsEl.querySelectorAll('.cp-item');
    if(!items.length)return;
    items.forEach(function(i){i.classList.remove('focused');});
    focusIdx=(focusIdx+d+items.length)%items.length;
    items[focusIdx].classList.add('focused');
    items[focusIdx].scrollIntoView({block:'nearest'});
  }

  function activateFocused(){
    items=resultsEl.querySelectorAll('.cp-item');
    var focused=focusIdx>=0&&items[focusIdx]?items[focusIdx]:items[0];
    if(focused){var href=focused.getAttribute('data-href');if(href)window.location.href=href;}
  }

  function statusBadge(s){
    if(!s)return'';
    var cls='cp-badge-gen';
    if(s==='CONSEGNATO'||s==='RICONSEGNATO')cls='cp-badge-cons';
    if(s==='INVALIDATO')cls='cp-badge-inv';
    return '<span class="cp-badge '+cls+'">'+s+'</span>';
  }

  function buildItem(href,icon,name,sub,badge){
    return '<a class="cp-item" data-href="'+href+'" href="'+href+'">'
      +'<span class="cp-icon">'+icon+'</span>'
      +'<span class="cp-label">'
        +'<div class="cp-name">'+escH(name)+'</div>'
        +(sub?'<div class="cp-sub">'+escH(sub)+'</div>':'')
      +'</span>'
      +(badge||'')
      +'</a>';
  }
  function escH(s){if(!s)return'';return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');}

  function render(data){
    focusIdx=-1;
    var html='';
    if(data.passes&&data.passes.length){
      html+='<div class="cp-section-title">🎫 Pass</div>';
      data.passes.forEach(function(p){
        html+=buildItem('/search?q='+encodeURIComponent(p.code||p.participant_name)+'&tab=passes',
          '🎫', p.participant_name, (p.stand_name||'')+' · '+p.pass_type_name, statusBadge(p.status));
      });
    }
    if(data.participants&&data.participants.length){
      html+='<div class="cp-section-title">👤 Partecipanti</div>';
      data.participants.forEach(function(p){
        html+=buildItem('/search?q='+encodeURIComponent(p.first_name+' '+p.last_name)+'&tab=participants',
          '👤', p.first_name+' '+p.last_name, (p.role||'')+(p.stand_name?' · '+p.stand_name:''), '');
      });
    }
    if(data.events&&data.events.length){
      html+='<div class="cp-section-title">📅 Eventi</div>';
      data.events.forEach(function(e){
        var sub=(e.space_name||'');
        if(e.event_type) sub+=(sub?' · ':'')+e.event_type;
        if(e.date) sub+=(sub?' · ':'')+e.date;
        if(e.start_time) sub+=(sub?' ':'')+(e.start_time.slice(0,5))+(e.end_time?'–'+e.end_time.slice(0,5):'');
        html+=buildItem('/agenda/events/'+e.id+'/edit',
          '📅', e.title, sub,
          '<span class="cp-badge cp-badge-event">Evento</span>');
      });
    }
    if(data.groups&&data.groups.length){
      html+='<div class="cp-section-title">🏪 Gruppi / Stand</div>';
      data.groups.forEach(function(g){
        html+=buildItem('/assignment-groups/'+g.id,
          '🏪', g.stand_name||g.name, (g.zone||'')+(g.name?' · '+g.name:''), '');
      });
    }
    var total=(data.passes?data.passes.length:0)+(data.participants?data.participants.length:0)+(data.groups?data.groups.length:0)+(data.events?data.events.length:0);
    if(!total) html='<div class="cp-empty">Nessun risultato trovato.</div>';
    html+='<a class="cp-item" data-href="/search?q='+encodeURIComponent(input.value)+'&tab=all" href="/search?q='+encodeURIComponent(input.value)+'&tab=all" style="border-top:1px solid #f0f2f5;color:var(--accent-blue)">'
      +'<span class="cp-icon">🔍</span>'
      +'<span class="cp-label"><div class="cp-name">Mostra tutti i risultati nella pagina avanzata</div></span>'
      +'</a>';
    resultsEl.innerHTML=html;
  }

  input.addEventListener('input',function(){
    clearTimeout(timer);
    var q=input.value.trim();
    if(q.length<2){renderEmpty();return;}
    renderLoading();
    timer=setTimeout(function(){
      fetch('/api/search?q='+encodeURIComponent(q))
        .then(function(r){return r.json();})
        .then(render)
        .catch(function(){resultsEl.innerHTML='<div class="cp-empty">Errore di rete.</div>';});
    },200);
  });
})();

// ── FAB: click, drag, scroll fix, viewport resize fix ──
(function(){
  var fab = document.getElementById('search-fab');
  if(!fab) return;

  // ── Apri palette ──
  fab.addEventListener('click', function(){
    if(fab._dragged) return;
    var ov  = document.getElementById('cp-overlay');
    var inp = document.getElementById('cp-q');
    if(!ov) return;
    ov.classList.add('open');
    if(inp) setTimeout(function(){ inp.focus(); }, 80);
  });

  // ── Drag touch ──
  var startX, startY, startRight, startBottom, moved;
  fab.addEventListener('touchstart', function(e){
    var t = e.touches[0];
    var rect = fab.getBoundingClientRect();
    startX = t.clientX; startY = t.clientY;
    startRight  = window.innerWidth  - rect.right;
    startBottom = window.innerHeight - rect.bottom;
    moved = false; fab._dragged = false;
    fab.classList.add('dragging');
  }, {passive:true});

  fab.addEventListener('touchmove', function(e){
    var t = e.touches[0];
    var dx = t.clientX - startX;
    var dy = t.clientY - startY;
    if(Math.abs(dx)>5 || Math.abs(dy)>5) moved = true;
    if(!moved) return;
    e.preventDefault();
    var newRight  = Math.max(8, Math.min(window.innerWidth  - 60, startRight  - dx));
    var newBottom = Math.max(8, Math.min(window.innerHeight - 60, startBottom - dy));
    fab.style.right  = newRight  + 'px';
    fab.style.bottom = newBottom + 'px';
  }, {passive:false});

  fab.addEventListener('touchend', function(){
    fab.classList.remove('dragging');
    if(moved){ fab._dragged = true; setTimeout(function(){ fab._dragged = false; }, 300); }
  });

  // ── Fix scroll overlay su mobile ──
  // Blocca scroll pagina se tocco è fuori da cp-results, lascia passare se è dentro
  var cpOverlay = document.getElementById('cp-overlay');
  var cpResults = document.getElementById('cp-results');
  if(cpOverlay && cpResults){
    cpOverlay.addEventListener('touchmove', function(e){
      if(cpResults.contains(e.target)){
        e.stopPropagation(); // scroll lista OK
      } else {
        e.preventDefault();  // blocca scroll pagina sotto
      }
    }, {passive:false});
  }

  // ── Fix viewport resize (tastiera mobile che appare/sparisce) ──
  // Quando la tastiera si chiude il browser ridisegna il viewport e i position:fixed
  // possono "congelarsi". Forziamo un reflow minimo sull'overlay.
  if(cpOverlay){
    var lastVH = window.innerHeight;
    window.addEventListener('resize', function(){
      var newVH = window.innerHeight;
      if(newVH !== lastVH){
        lastVH = newVH;
        if(cpOverlay.classList.contains('open')){
          // reflow: toglie e rimette display per sbloccare il fixed
          cpOverlay.style.display = 'none';
          // eslint-disable-next-line no-unused-expressions
          cpOverlay.offsetHeight; // forza reflow
          cpOverlay.style.display = '';
        }
      }
    });
  }
})();
</script>
<% } %>