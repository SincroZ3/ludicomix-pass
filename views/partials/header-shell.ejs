<header class="topbar">
    <div class="brand">
      <%- include('partials/assets/brand-ciuco-img') %>
      <%- include('partials/assets/brand-logo-img') %>
      <div class="brand-text-block">
        <div class="brand-sub">Area di gestione pass</div>
        <% if (currentUser) { %>
          <div class="brand-user">Accesso come: <strong><%= currentUser.username %></strong> &nbsp;&middot;&nbsp; Ruolo: <strong><%=
            currentUser.role === 'admin'      ? 'Amministratore' :
            currentUser.role === 'organizer'  ? 'Organizzatore'  :
            currentUser.role === 'accountant' ? 'Amministrazione contabile' :
            currentUser.role === 'operator'   ? 'Operatore'      :
            currentUser.role === 'scanner'    ? 'Scanner'        :
            currentUser.role === 'viewer'     ? 'Visualizzatore' :
            currentUser.role
          %></strong></div>
        <% } %>
      </div>
    </div>
    <% if (currentUser) { %>
    <% if(currentUser&&currentUser.role==="admin"){ %><div id="nb" style="position:relative;margin-left:.25rem;"><a href="/notifications" style="display:flex;align-items:center;justify-content:center;width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,.15);color:#fff;text-decoration:none;font-size:1rem;" title="Notifiche">&#128276;</a><span id="nbc" style="display:none;position:absolute;top:-3px;right:-3px;background:#c0392b;color:#fff;border-radius:9999px;min-width:16px;height:16px;font-size:.56rem;font-weight:800;line-height:16px;text-align:center;padding:0 3px;"></span></div><% } %>
  <form method="post" action="/logout" class="logout-form">
      <button type="submit">Logout</button>
    </form>
    <% } %>
  </header>
  <% if (currentUser) { %>
  <nav class="main-nav">
    <% if(currentUser && currentUser.role === 'scanner'){ %>
      <a href="/scan">&#128247; Scanner QR</a>
          <a href="/contatore" class="nav-link<% if(typeof path !== 'undefined' && path=='/contatore'){%> active<%}%>">🎟️ Contatore</a>
      <a href="/account/password">&#128273; Cambia Password</a>
    <% } else { %>
      <a href="/home">&#127968; Home</a>
      <a href="/participants">&#128101; Assegnatari Pass</a>
      <a href="/passes">&#127915; Pass generati</a>
      <a href="/mappa">&#128506; Mappa Stand</a>
      <% if(currentUser&&(currentUser.role==='admin'||currentUser.role==='organizer')){ %>
        <a href="/import">&#128229; Import CSV</a>
      <% } %>
      <a href="/reports">&#128202; Reports</a>
      <a href="/agenda">&#128197; Agenda</a>
      <a href="/volunteers">🙋 Volontari</a>
      <a href="/search">&#128269; Ricerca Pass</a>
      <a href="/scan">&#128247; Scanner QR</a>
          <a href="/contatore" class="nav-link<% if(typeof path !== 'undefined' && path=='/contatore'){%> active<%}%>">🎟️ Contatore</a>
      <a href="/account/password">&#128273; Cambia Password</a>
      <% if(currentUser&&currentUser.role!=='viewer'){ %>
        <a href="/account/security">&#128274; Password di Sicurezza</a>
      <% } %>
      <% if(typeof canAccessPersonalArea !== 'undefined' && canAccessPersonalArea){ %>
        <a href="/area-personale">&#128188; Area Personale</a>
      <% } %>
      <% if(typeof canAccessAccounting !== 'undefined' && canAccessAccounting){ %>
        <a href="/area-personale/rimborsi">&#128181; Richieste Rimborsi</a>
      <% } %>
      <% if(currentUser&&(currentUser.role==='admin'||currentUser.role==='organizer')){ %>
        <a href="/admin/logistica">📦 Logistica</a>
        <a href="/admin/bacheca">&#128226; Bacheca</a>
        <a href="/admin/accreditamento">&#127981; Accreditamento</a>
      <% } %>
      <% if(currentUser&&currentUser.role==='admin'){ %>
        <a href="/admin/settings">&#9881;&#65039; Impostazioni</a>
        <a href="/admin/logs">&#128220; Log Azioni</a>
      <% } %>
    <% } %>
  </nav>
  <% } %>