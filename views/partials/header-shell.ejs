<header class="topbar">
  <div class="brand">
    <%- include('assets/brand-ciuco-img') %>
    <%- include('assets/brand-logo-img') %>
    <div class="brand-text-block">
      <div class="brand-sub">Portale di gestione</div>
      <% if (currentUser) { %>
        <div class="brand-user">Accesso come: <strong><%= currentUser.username %></strong> &nbsp;&middot;&nbsp; Ruolo: <strong><%=
          currentUser.role === 'admin'      ? 'Amministratore' :
          currentUser.role === 'organizer'  ? 'Organizzatore'  :
          currentUser.role === 'accountant' ? 'Amministrazione contabile' :
          currentUser.role === 'operator'   ? 'Operatore'      :
          currentUser.role === 'scanner'    ? 'Scanner'        :
          currentUser.role === 'viewer'     ? 'Visualizzatore' :
          currentUser.role %></strong></div>
      <% } %>
    </div>
  </div>

  <% if (currentUser) { %>
  <div class="header-search">
    <span class="header-search-icon">&#128269;</span>
    <input type="text" id="header-search-input" class="header-search-input" placeholder="Cosa stai cercando?" autocomplete="off">
  </div>

  <div class="header-icons">
    <% if (currentUser.role === 'admin') { %>
      <a href="/notifications" class="icon-circle" title="Notifiche">
        &#128276;
        <span id="notif-badge" class="icon-badge" style="display:none">0</span>
      </a>
    <% } %>
    <a href="/scan" class="icon-circle" title="Scanner QR">&#128247;</a>
    <a href="/contatore" class="icon-circle" title="Contatore presenze">&#128202;</a>
    <% if (currentUser.role === 'admin') { %>
      <a href="/admin/logs" class="icon-circle" title="Log azioni">&#128220;</a>
    <% } %>
    <form action="/logout" method="POST" class="icon-circle-form">
      <button type="submit" class="icon-circle" title="Logout">&#9211;</button>
    </form>
  </div>
  <% } %>
</header>

<% if (currentUser) { %>
<nav class="main-nav" id="main-nav-bar">
  <% if (currentUser.role === 'scanner') { %>

    <a href="/scan">&#128247; Scanner QR</a>
    <a href="/contatore">&#127917; Contatore</a>
    <a href="/account/password">&#128273; Cambia Password</a>

  <% } else { %>

    <a href="/home">&#127968; Home</a>
    <a href="/participants">&#128101; Assegnatari Pass</a>
    <a href="/mappa">&#128506; Mappa Stand</a>
    <a href="/agenda">&#128197; Agenda</a>
    <a href="/volunteers">&#128587; Volontari</a>

    <% if (currentUser.role === 'admin' || currentUser.role === 'organizer') { %>
      <a href="/admin/logistica">&#128230; Logistica</a>
      <a href="/admin/accreditamento">&#127981; Accreditamento</a>
    <% } %>

    <% if (typeof canAccessPersonalArea !== 'undefined' && canAccessPersonalArea) { %>
      <a href="/area-personale">&#128188; Area Personale</a>
    <% } %>

    <div class="nav-dropdown">
      <button type="button" class="nav-dropdown-toggle" id="settings-dropdown-toggle">&#9881;&#65039; Impostazioni &#9662;</button>
      <div class="nav-dropdown-menu" id="settings-dropdown-menu">
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/settings">&#9881;&#65039; Impostazioni di sistema</a>
        <% } %>
        <a href="/passes">&#127915; Pass generati</a>
        <a href="/reports">&#128202; Reports</a>
        <a href="/search">&#128269; Ricerca avanzata</a>
        <% if (currentUser.role === 'admin' || currentUser.role === 'organizer') { %>
          <a href="/import">&#128229; Import CSV</a>
          <a href="/admin/bacheca">&#128226; Bacheca</a>
        <% } %>
        <% if (typeof canAccessAccounting !== 'undefined' && canAccessAccounting) { %>
          <a href="/area-personale/rimborsi">&#128181; Richieste Rimborsi</a>
        <% } %>
        <a href="/account/password">&#128273; Cambia Password</a>
        <% if (currentUser.role !== 'viewer') { %>
          <a href="/account/security">&#128274; Password di Sicurezza</a>
        <% } %>
      </div>
    </div>

  <% } %>
</nav>
<% } %>

<script>
(function(){
  // ── Ricerca nella barra gialla dell'header: riusa la command palette esistente ──
  var hs = document.getElementById('header-search-input');
  if (hs) {
    function openPaletteWithValue(){
      var ov  = document.getElementById('cp-overlay');
      var inp = document.getElementById('cp-q');
      if (!ov || !inp) return;
      ov.classList.add('open');
      inp.value = hs.value;
      inp.dispatchEvent(new Event('input'));
      setTimeout(function(){ inp.focus(); }, 30);
    }
    hs.addEventListener('focus', openPaletteWithValue);
    hs.addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); openPaletteWithValue(); }
    });
  }

  // ── Menu a tendina Impostazioni ──────────────────────────────────
  var toggleBtn = document.getElementById('settings-dropdown-toggle');
  var menu      = document.getElementById('settings-dropdown-menu');

  if (toggleBtn && menu) {

    // FIX 21/09 (v5) — CAUSA REALE CONFERMATA CON TEST elementFromPoint:
    // il menu era posizionato correttamente (position:fixed, coordinate
    // dentro lo schermo, display:flex) e riceveva regolarmente i tocchi
    // (elementFromPoint lo trovava), ma non veniva MAI dipinto a schermo.
    // Questo è un bug noto di WebKit: un elemento position:fixed che è
    // figlio nel DOM di un contenitore con -webkit-overflow-scrolling:touch
    // (il nostro .main-nav scrollabile) può restare "intrappolato" nel
    // livello di composizione grafica di quel contenitore, anche se
    // posizionato fuori dal suo flusso normale. Il fix definitivo è
    // spostare il menu fuori dall'albero DOM della nav, rendendolo figlio
    // diretto di <body>: così non fa più parte del contesto di scroll
    // che causava il mancato ridisegno.
    if (menu.parentNode !== document.body) {
      document.body.appendChild(menu);
    }

    var lastToggleAt = 0;

    function openMenu(){
      requestAnimationFrame(function(){
        var rect = toggleBtn.getBoundingClientRect();
        var margin = 8;
        var menuWidth = menu.offsetWidth || 230;
        var maxLeft = window.innerWidth - menuWidth - margin;

        var left = rect.left;
        if (left > maxLeft) left = maxLeft;
        if (left < margin) left = margin;

        var top = rect.bottom;
        var maxTop = window.innerHeight - margin;
        if (top > maxTop) top = maxTop;

        menu.style.top  = top + 'px';
        menu.style.left = left + 'px';
        menu.classList.add('open');
      });
    }
    function closeMenu(){
      menu.classList.remove('open');
    }
    function handleToggle(e){
      var now = Date.now();
      if (now - lastToggleAt < 400) {
        e.preventDefault();
        return;
      }
      lastToggleAt = now;
      e.preventDefault();
      e.stopPropagation();
      if (menu.classList.contains('open')) closeMenu();
      else openMenu();
    }

    toggleBtn.addEventListener('touchend', handleToggle, { passive: false });
    toggleBtn.addEventListener('click', handleToggle);

    document.addEventListener('click', function(e){
      if (e.target !== toggleBtn && !toggleBtn.contains(e.target) && !menu.contains(e.target)) closeMenu();
    });
    document.addEventListener('touchend', function(e){
      if (e.target !== toggleBtn && !toggleBtn.contains(e.target) && !menu.contains(e.target)) closeMenu();
    }, { passive: true });
    window.addEventListener('resize', closeMenu);
    window.addEventListener('scroll', closeMenu, true);
  }

  // ── Badge notifiche non lette (polling) ──
  var badge = document.getElementById('notif-badge');
  if (badge) {
    function refreshBadge(){
      fetch('/api/notifications/count').then(function(r){ return r.json(); }).then(function(data){
        var n = (data && data.count) || 0;
        if (n > 0) { badge.textContent = n > 99 ? '99+' : n; badge.style.display = 'flex'; }
        else { badge.style.display = 'none'; }
      }).catch(function(){});
    }
    refreshBadge();
    setInterval(refreshBadge, 30000);
  }
})();
</script>
