<style>
/* ── Menu hamburger mobile (sostituisce i pallini che andavano sotto il logo) ── */
.hdr-burger-wrap { display: none; position: relative; }
.hdr-burger { display: none; }

.hdr-fan {
  position: absolute;
  top: calc(100% + 10px);
  right: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 10px;
  z-index: 10000;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0s linear .35s;
}
.hdr-fan.open {
  visibility: visible;
  pointer-events: auto;
  transition-delay: 0s;
}
.hdr-fan-item {
  display: flex;
  align-items: center;
  gap: 10px;
  margin: 0;
  padding: 0;
  border: 0;
  background: none;
  font: inherit;
  text-decoration: none;
  cursor: pointer;
  opacity: 0;
  transform: translateY(-18px) scale(.9);
  transform-origin: top right;
  transition: opacity .18s ease, transform .3s cubic-bezier(.16, 1, .3, 1);
  -webkit-tap-highlight-color: transparent;
}
.hdr-fan.open .hdr-fan-item {
  opacity: 1;
  transform: none;
  transition-delay: calc(var(--i, 0) * 55ms);
}
.hdr-fan-item:hover { text-decoration: none; }
.hdr-fan-label {
  background: #fff;
  color: #4c2c78;
  font-weight: 700;
  font-size: .85rem;
  line-height: 1;
  padding: .5rem .85rem;
  border-radius: 999px;
  white-space: nowrap;
  box-shadow: 0 3px 10px rgba(30, 20, 60, .28);
}
.hdr-fan-item .icon-circle {
  box-shadow: 0 3px 10px rgba(30, 20, 60, .3), 0 0 0 2px rgba(107, 63, 160, .18);
}
.hdr-fan-form { margin: 0; }

/* ── Tooltip animato sulle icone tonde (solo desktop con mouse) ── */
.header-icons .icon-tip {
  position: absolute;
  top: calc(100% + 12px);
  right: -6px;
  z-index: 10001;
  width: max-content;
  max-width: 230px;
  padding: .55rem .8rem .6rem;
  border-radius: 12px;
  background: #2b1a47;
  color: #fff;
  text-align: left;
  text-transform: none;
  font-family: -apple-system, 'Segoe UI', Arial, sans-serif;
  cursor: default;
  box-shadow: 0 8px 22px rgba(20, 10, 40, .35);
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
  transform: translateY(-8px) scale(.95);
  transform-origin: top right;
  transition: opacity .16s ease, transform .2s ease, visibility 0s linear .2s;
}
.header-icons .icon-tip::before {
  content: "";
  position: absolute;
  top: -5px;
  right: 24px;
  width: 10px;
  height: 10px;
  background: #2b1a47;
  border-radius: 2px;
  transform: rotate(45deg);
}
.header-icons .icon-tip .tip-title {
  display: block;
  font-size: .85rem;
  font-weight: 800;
  line-height: 1.2;
  color: #f5c842;
}
.header-icons .icon-tip .tip-desc {
  display: block;
  margin-top: .2rem;
  font-size: .75rem;
  font-weight: 500;
  line-height: 1.35;
  color: #efe7fb;
}
@media (hover: hover) and (min-width: 641px) {
  .header-icons .icon-circle:hover .icon-tip,
  .header-icons .icon-circle:focus-visible .icon-tip {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition: opacity .18s ease .35s, transform .28s cubic-bezier(.16, 1, .3, 1) .35s, visibility 0s linear .35s;
  }
}

@media (max-width: 640px) {
  .topbar { flex-wrap: nowrap; justify-content: space-between; }
  .brand { min-width: 0; flex: 0 1 auto; }
  .brand-combo { max-width: 100%; object-fit: contain; object-position: left center; }
  .header-right-col { margin-left: auto; }
  .header-icons { display: none; }
  .hdr-burger-wrap { display: block; }
  .hdr-burger { display: flex; }
}

@media (prefers-reduced-motion: reduce) {
  .hdr-fan-item, .hdr-fan.open .hdr-fan-item { transition-duration: .01ms; transition-delay: 0s; }
  .header-icons .icon-tip { transition-duration: .01ms !important; transition-delay: 0s !important; }
}
</style>

<header class="topbar">
  <div class="brand">
    <img src="/ciuco-logo-combo.png" alt="Ludicomix - Portale di gestione" class="brand-combo">
  </div>

  <% if (currentUser) { %>
  <div class="topbar-user-line">
    Accesso come: <strong><%= currentUser.username %></strong>
    &nbsp;&middot;&nbsp; Ruolo: <strong><%=
      currentUser.role === 'admin'      ? 'Amministratore' :
      currentUser.role === 'organizer'  ? 'Organizzatore'  :
      currentUser.role === 'accountant' ? 'Amministrazione contabile' :
      currentUser.role === 'operator'   ? 'Operatore'      :
      currentUser.role === 'scanner'    ? 'Scanner'        :
      currentUser.role === 'viewer'     ? 'Visualizzatore' :
      currentUser.role
    %></strong>
  </div>

  <div class="header-search">
    <span class="header-search-icon">&#128269;</span>
    <input type="text" id="header-search-input" class="header-search-input" placeholder="Cosa stai cercando?" autocomplete="off">
  </div>

  <div class="header-right-col">
    <div class="header-icons">
      <% if (currentUser.role === 'admin') { %>
        <a href="/notifications" class="icon-circle" aria-label="Notifiche">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span id="notif-badge" class="icon-badge js-notif-badge" style="display:none">0</span>
          <span class="icon-tip" role="tooltip"><span class="tip-title">Notifiche</span><span class="tip-desc">Avvisi di sistema e nuove richieste dal portale.</span></span>
        </a>
      <% } %>
      <a href="/scan" class="icon-circle" aria-label="Scanner QR">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><rect x="7" y="7" width="10" height="10" rx="1"/></svg>
        <span class="icon-tip" role="tooltip"><span class="tip-title">Scanner QR</span><span class="tip-desc">Scansiona i pass e verifica gli ingressi.</span></span>
      </a>
      <a href="/contatore" class="icon-circle" aria-label="Contatore presenze">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
        <span class="icon-tip" role="tooltip"><span class="tip-title">Contatore presenze</span><span class="tip-desc">Conteggio delle persone presenti all'evento.</span></span>
      </a>
      <% if (currentUser.role === 'admin') { %>
        <a href="/admin/logs" class="icon-circle" aria-label="Log azioni">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>
          <span class="icon-tip" role="tooltip"><span class="tip-title">Log azioni</span><span class="tip-desc">Cronologia delle operazioni fatte dagli utenti.</span></span>
        </a>
      <% } %>
      <form action="/logout" method="POST" class="icon-circle-form">
        <button type="submit" class="icon-circle" aria-label="Logout">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          <span class="icon-tip" role="tooltip"><span class="tip-title">Logout</span><span class="tip-desc">Esci dal portale in sicurezza.</span></span>
        </button>
      </form>
    </div>

    <!-- Menu hamburger (visibile solo su schermi stretti) -->
    <div class="hdr-burger-wrap">
      <button type="button" class="icon-circle hdr-burger" id="hdr-burger" aria-label="Menu" aria-haspopup="true" aria-expanded="false" aria-controls="hdr-fan">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="4" y1="7" x2="20" y2="7"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="17" x2="20" y2="17"/></svg>
        <% if (currentUser.role === 'admin') { %><span class="icon-badge js-notif-badge" style="display:none">0</span><% } %>
      </button>

      <div class="hdr-fan" id="hdr-fan">
        <% var fanIdx = 0; %>
        <% if (currentUser.role === 'admin') { %>
          <a href="/notifications" class="hdr-fan-item" style="--i:<%= fanIdx++ %>">
            <span class="hdr-fan-label">Notifiche</span>
            <span class="icon-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
              <span class="icon-badge js-notif-badge" style="display:none">0</span>
            </span>
          </a>
        <% } %>
        <a href="/scan" class="hdr-fan-item" style="--i:<%= fanIdx++ %>">
          <span class="hdr-fan-label">Scanner QR</span>
          <span class="icon-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><rect x="7" y="7" width="10" height="10" rx="1"/></svg>
          </span>
        </a>
        <a href="/contatore" class="hdr-fan-item" style="--i:<%= fanIdx++ %>">
          <span class="hdr-fan-label">Contatore presenze</span>
          <span class="icon-circle">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </span>
        </a>
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/logs" class="hdr-fan-item" style="--i:<%= fanIdx++ %>">
            <span class="hdr-fan-label">Log azioni</span>
            <span class="icon-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 2h6a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H9a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2z"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="16" y2="12"/><line x1="8" y1="16" x2="12" y2="16"/></svg>
            </span>
          </a>
        <% } %>
        <form action="/logout" method="POST" class="hdr-fan-form">
          <button type="submit" class="hdr-fan-item" style="--i:<%= fanIdx++ %>">
            <span class="hdr-fan-label">Logout</span>
            <span class="icon-circle">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#3d2265" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            </span>
          </button>
        </form>
      </div>
    </div>
  </div>
  <% } %>
</header>

<% if (currentUser) { %>
<nav class="main-nav" id="main-nav-bar">
  <% if (currentUser.role === 'scanner') { %>

    <a href="/scan">Scanner QR</a>
    <a href="/contatore">Contatore</a>
    <a href="/account/password">Cambia Password</a>

  <% } else { %>

    <a href="/home">Home</a>
    <a href="/participants">Assegnatari Pass</a>
    <a href="/mappa">Mappa Stand</a>
    <a href="/agenda">Agenda</a>
    <a href="/volunteers">Volontari</a>

    <% if (currentUser.role === 'admin' || currentUser.role === 'organizer') { %>
      <a href="/admin/logistica">Logistica</a>
      <a href="/admin/accreditamento">Accreditamento</a>
    <% } %>

    <% if (typeof canAccessPersonalArea !== 'undefined' && canAccessPersonalArea) { %>
      <a href="/area-personale">Area Personale</a>
    <% } %>

    <div class="nav-dropdown">
      <button type="button" class="nav-dropdown-toggle" id="settings-dropdown-toggle">Impostazioni &#9662;</button>
      <div class="nav-dropdown-menu" id="settings-dropdown-menu">
        <% if (currentUser.role === 'admin') { %>
          <a href="/admin/settings">&#9881;&#65039; Impostazioni di sistema</a>
        <% } %>
        <a href="/passes">&#127915; Pass generati</a>
        <a href="/reports">&#128202; Reports</a>
        <a href="/search">&#128269; Ricerca avanzata</a>
        <% if (currentUser.role === 'admin' || currentUser.role === 'organizer') { %>
          <a href="/import">&#128229; Import CSV</a>
          <a href="/admin/bacheca">&#128226; Bacheca</a>
        <% } %>
        <% if (typeof canAccessAccounting !== 'undefined' && canAccessAccounting) { %>
          <a href="/area-personale/rimborsi">&#128181; Richieste Rimborsi</a>
        <% } %>
        <a href="/account/password">&#128273; Cambia Password</a>
        <% if (currentUser.role !== 'viewer') { %>
          <a href="/account/security">&#128274; Password di Sicurezza</a>
        <% } %>
      </div>
    </div>

  <% } %>
</nav>
<% } %>

<script>
(function(){
  // ── Ricerca nella barra gialla dell'header: riusa la command palette esistente ──
  var hs = document.getElementById('header-search-input');
  if (hs) {
    function openPaletteWithValue(){
      var ov  = document.getElementById('cp-overlay');
      var inp = document.getElementById('cp-q');
      if (!ov || !inp) return;
      ov.classList.add('open');
      inp.value = hs.value;
      inp.dispatchEvent(new Event('input'));
      setTimeout(function(){ inp.focus(); }, 30);
    }
    hs.addEventListener('focus', openPaletteWithValue);
    hs.addEventListener('keydown', function(e){
      if (e.key === 'Enter') { e.preventDefault(); openPaletteWithValue(); }
    });
  }

  // ── Menu hamburger mobile (pallino con tre linee) ──
  var burger = document.getElementById('hdr-burger');
  var fan    = document.getElementById('hdr-fan');
  if (burger && fan) {
    var setFan = function(open){
      fan.classList.toggle('open', open);
      burger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };
    burger.addEventListener('click', function(e){
      e.stopPropagation();
      setFan(!fan.classList.contains('open'));
    });
    document.addEventListener('click', function(e){
      if (!fan.contains(e.target) && !burger.contains(e.target)) setFan(false);
    });
    document.addEventListener('keydown', function(e){
      if (e.key === 'Escape') setFan(false);
    });
    window.addEventListener('resize', function(){
      if (window.innerWidth > 640) setFan(false);
    });
  }

  // ── Menu a tendina Impostazioni (fix definitivo v5: menu spostato
  //     come figlio diretto di body per evitare il bug di compositing
  //     WebKit dentro contenitori con overflow-x scrollabile) ──
  var toggleBtn = document.getElementById('settings-dropdown-toggle');
  var menu      = document.getElementById('settings-dropdown-menu');

  if (toggleBtn && menu) {
    if (menu.parentNode !== document.body) {
      document.body.appendChild(menu);
    }

    var lastToggleAt = 0;

    function openMenu(){
      requestAnimationFrame(function(){
        var rect = toggleBtn.getBoundingClientRect();
        var margin = 8;
        var menuWidth = menu.offsetWidth || 230;
        var maxLeft = window.innerWidth - menuWidth - margin;

        var left = rect.left;
        if (left > maxLeft) left = maxLeft;
        if (left < margin) left = margin;

        var top = rect.bottom;
        var maxTop = window.innerHeight - margin;
        if (top > maxTop) top = maxTop;

        menu.style.top  = top + 'px';
        menu.style.left = left + 'px';
        menu.classList.add('open');
      });
    }
    function closeMenu(){
      menu.classList.remove('open');
    }
    function handleToggle(e){
      var now = Date.now();
      if (now - lastToggleAt < 400) {
        e.preventDefault();
        return;
      }
      lastToggleAt = now;
      e.preventDefault();
      e.stopPropagation();
      if (menu.classList.contains('open')) closeMenu();
      else openMenu();
    }

    toggleBtn.addEventListener('touchend', handleToggle, { passive: false });
    toggleBtn.addEventListener('click', handleToggle);

    document.addEventListener('click', function(e){
      if (e.target !== toggleBtn && !toggleBtn.contains(e.target) && !menu.contains(e.target)) closeMenu();
    });
    document.addEventListener('touchend', function(e){
      if (e.target !== toggleBtn && !toggleBtn.contains(e.target) && !menu.contains(e.target)) closeMenu();
    }, { passive: true });
    window.addEventListener('resize', closeMenu);
    window.addEventListener('scroll', closeMenu, true);
  }

  // ── Badge notifiche non lette (polling): aggiorna tutti i badge (desktop, hamburger, menu) ──
  var badges = document.querySelectorAll('.js-notif-badge');
  if (badges.length) {
    function refreshBadge(){
      fetch('/api/notifications/count').then(function(r){ return r.json(); }).then(function(data){
        var n = (data && data.count) || 0;
        badges.forEach(function(b){
          if (n > 0) { b.textContent = n > 99 ? '99+' : n; b.style.display = 'flex'; }
          else { b.style.display = 'none'; }
        });
      }).catch(function(){});
    }
    refreshBadge();
    setInterval(refreshBadge, 30000);
  }
})();
</script>
