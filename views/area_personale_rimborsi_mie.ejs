<%- include('partials/header') %>
<nav class="breadcrumb-bar">Sei in: <a href="/home">Home</a> <span class="sep">›</span> <a href="/area-personale">Area Personale</a> <span class="sep">›</span> <strong>Richieste Rimborso</strong></nav>
<h1 class="page-title">📄 Le Mie Richieste di Rimborso</h1>

<% if (!profileComplete) { %>
  <div class="alert alert-warning">
    ⚠️ Completa prima <a href="/area-personale/profilo">il tuo profilo</a> (nome, luogo/data di nascita, codice fiscale) per poter inviare richieste.
  </div>
<% } else if (availableExpenses.length > 0) { %>
  <div class="card">
    <div class="card-title">➕ Nuova richiesta di rimborso</div>
    <form method="POST" action="/area-personale/richieste-rimborso">
      <p class="help-text">Seleziona una o più spese non ancora incluse in una richiesta:</p>
      <div class="table-wrapper" style="max-height:260px;overflow-y:auto;">
        <table>
          <thead><tr><th></th><th>Data</th><th>Descrizione</th><th>Importo</th></tr></thead>
          <tbody>
            <% availableExpenses.forEach(function(e){ %>
            <tr>
              <td><input type="checkbox" name="expense_ids" value="<%= e.id %>" style="width:auto;"></td>
              <td><%= e.expense_date %></td>
              <td><%= e.description %></td>
              <td>€ <%= e.amount.toFixed(2) %></td>
            </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <p class="help-text" style="margin-top:1rem;">Il modulo PDF di autocertificazione riporta mese/anno di riferimento e l'importo totale — compilalo come indicato nel modulo cartaceo:</p>
      <div style="display:flex;gap:.6rem;">
        <label style="flex:1;">Mese <input type="text" name="period_month" maxlength="20" placeholder="es. Maggio"></label>
        <label style="flex:1;">Anno <input type="text" name="period_year" maxlength="4" placeholder="es. 2026"></label>
      </div>
      <label style="margin-top:.6rem;">Luogo (dove firmi il documento)
        <input type="text" name="sign_place" id="sign-place" maxlength="80" placeholder="es. Empoli">
      </label>
      <label style="margin-top:.6rem;">IBAN per il bonifico
        <input type="text" name="iban" value="<%= user.iban || '' %>" maxlength="34" style="text-transform:uppercase;">
      </label>
      <input type="hidden" name="sign_digitally" id="sign-digitally-flag" value="0">
      <div style="margin-top:1rem;">
        <button type="button" class="primary" onclick="beforeSubmit(this.form)">📄 Genera richiesta e modulo PDF</button>
      </div>
    </form>
  </div>

  <div class="modal-overlay" id="modal-sign-confirm">
    <div class="modal">
      <div class="modal-header"><h2>✍️ Firma digitale</h2><button class="modal-close" onclick="document.getElementById('modal-sign-confirm').style.display='none'">✕</button></div>
      <div class="modal-body">
        <% if (hasSignature) { %>
          <p>Vuoi firmare digitalmente questo documento con la tua firma salvata nel profilo?</p>
        <% } else { %>
          <p>Non hai ancora caricato una firma nel <a href="/area-personale/profilo" target="_blank">tuo profilo</a>. Il documento verrà generato senza firma — potrai firmarlo a mano dopo averlo scaricato.</p>
        <% } %>
      </div>
      <div class="modal-actions" style="padding:0 1.2rem 1.2rem;">
        <% if (hasSignature) { %>
          <button type="button" class="secondary" onclick="submitForm(false)">No, lascio da firmare a mano</button>
          <button type="button" class="primary" onclick="submitForm(true)">✍️ Sì, firma digitalmente</button>
        <% } else { %>
          <button type="button" class="primary" onclick="submitForm(false)">Continua senza firma</button>
        <% } %>
      </div>
    </div>
  </div>
<% } else { %>
  <div class="alert alert-info">Nessuna spesa disponibile da includere in una nuova richiesta. Aggiungine dalla sezione <a href="/area-personale/spese">Spese</a>.</div>
<% } %>

<div class="table-wrapper" style="margin-top:1.5rem;">
  <table>
    <thead><tr><th>#</th><th>Data richiesta</th><th>Periodo</th><th>Importo</th><th>Edizione</th><th>Stato</th><th>Revisore</th><th></th></tr></thead>
    <tbody>
      <% requests.forEach(function(r){ %>
      <tr>
        <td>#<%= r.id %></td>
        <td><%= r.created_at %></td>
        <td><%= r.period_label || '—' %></td>
        <td>€ <%= r.total_amount.toFixed(2) %></td>
        <td><%= r.edition_name || '—' %></td>
        <td>
          <% if (r.status === 'in_attesa') { %><span class="chip" style="background:#fff8e1;color:#7d5a00;">⏳ In attesa</span>
          <% } else if (r.status === 'approvata') { %><span class="chip" style="background:#eafaf1;color:#1d6a39;">✅ Approvata</span>
          <% } else { %><span class="chip" style="background:#fef0f0;color:#922b21;">❌ Rifiutata</span><% } %>
        </td>
        <td><%= r.reviewer_name || '—' %></td>
        <td style="white-space:nowrap;">
          <a class="link-action" href="/area-personale/richieste-rimborso/<%= r.id %>/pdf?inline=1" target="_blank">📄 Visualizza PDF</a>
          <% if (r.status === 'in_attesa') { %>
            <form method="POST" action="/area-personale/richieste-rimborso/<%= r.id %>/annulla" style="display:inline;margin-left:.4rem;" onsubmit="return confirm('Annullare questa richiesta? Le spese torneranno disponibili per una nuova richiesta.')">
              <button type="submit" class="btn-danger" style="padding:.15rem .5rem;">✕ Annulla</button>
            </form>
          <% } %>
        </td>
      </tr>
      <% }); %>
      <% if (!requests.length) { %><tr><td colspan="8" class="help-text">Nessuna richiesta inviata.</td></tr><% } %>
    </tbody>
  </table>
</div>

<script>
function beforeSubmit(form){
  document.getElementById('modal-sign-confirm').style.display = 'flex';
  window._pendingForm = form;
}
function submitForm(sign){
  document.getElementById('sign-digitally-flag').value = sign ? '1' : '0';
  document.getElementById('modal-sign-confirm').style.display = 'none';
  window._pendingForm.submit();
}
</script>

<%- include('partials/footer') %>
