<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#5b2e8b">
  <title>Ludicomix Empoli — Accesso</title>
  <style>
    :root {
      --violet: #6b3fa0;
      --violet-dark: #4c2c78;
      --yellow: #f5c842;
      --navy: #1e2d4e;
      --red: #c0392b;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; max-width: 100vw; overflow-x: hidden; }

    /* Stessa struttura della finestra di login di Lucca 60: scheda bianca centrata su sfondo a foto */
    body.gateway-body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 20px;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #000;
      background:
        linear-gradient(135deg, rgba(63, 33, 104, .38) 0%, rgba(107, 63, 160, .18) 55%, rgba(30, 45, 78, .32) 100%),
        url('/parco.jpg') center center / cover no-repeat;
      background-color: var(--violet-dark);
    }

    .gateway-box {
      background: #fff;
      padding: 40px 32px;
      border-radius: 20px;
      text-align: center;
      box-shadow: 0 8px 30px rgba(0, 0, 0, .35);
      width: min(320px, 100%);
    }

    .gateway-logo {
      display: block;
      width: 70%;
      max-width: 220px;
      height: auto;
      margin: 0 auto 16px;
      user-select: none;
      -webkit-user-drag: none;
    }

    .gateway-title { margin: 0 0 4px; font-size: 1.3rem; font-weight: 800; }
    .gateway-subtitle { margin: 0 0 18px; font-size: .85rem; color: #777; }

    .gateway-form input {
      width: 100%;
      padding: 12px;
      margin-bottom: 12px;
      border: none;
      border-bottom: 2px solid #ddd;
      background: transparent;
      font: inherit;
      font-size: .95rem;
      outline: none;
      border-radius: 0;
    }
    .gateway-form input:focus { border-bottom-color: var(--violet); }

    .error-msg { color: var(--red); margin-bottom: 10px; font-size: .9rem; }

    /* Tasto nei colori Ludi: giallo con testo blu notte */
    .btn {
      display: inline-block;
      padding: 10px 16px;
      border-radius: 8px;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      border: none;
      text-decoration: none;
    }
    .btn-ludi {
      background: var(--yellow);
      color: var(--navy);
      box-shadow: 0 2px 6px rgba(30, 45, 78, .25);
      transition: background .15s, transform .1s;
    }
    .btn-ludi:hover { background: #ffe066; }
    .btn-ludi:active { transform: scale(.98); }
    .btn.full { width: 100%; margin-top: 10px; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition-duration: .01ms !important; }
    }
  </style>
</head>
<body class="gateway-body">
  <div class="gateway-box">
    <img src="/ciuc-log-work.png" alt="Ludicomix Empoli" class="gateway-logo">
    <h1 class="gateway-title">Area riservata</h1>
    <p class="gateway-subtitle">Accedi con le tue credenziali</p>
    <% if (error) { %><div class="error-msg" role="alert"><%= error %></div><% } %>
    <form method="POST" action="/login" class="gateway-form" autocomplete="on">
      <input type="text" name="username" placeholder="Username" required autofocus autocomplete="username">
      <input type="password" name="password" placeholder="Password" required autocomplete="current-password">
      <button type="submit" class="btn btn-ludi full">Accedi</button>
    </form>
  </div>
</body>
</html>
