<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#5b2e8b">
  <title>Ludicomix Empoli — Accesso</title>
  <style>
    :root {
      --violet-deep: #3f2168;
      --violet-dark: #542b81;
      --violet: #6b3fa0;
      --violet-light: #9565c7;
      --yellow: #f5c842;
      --yellow-light: #ffe16f;
      --ink: #25143b;
      --glass-border: rgba(255, 255, 255, .43);
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; max-width: 100vw; overflow-x: hidden; }

    body.gateway-body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 20px;
      color: #fff;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Arial, sans-serif;
      background:
        linear-gradient(135deg, rgba(63, 33, 104, .38) 0%, rgba(107, 63, 160, .18) 55%, rgba(30, 45, 78, .32) 100%),
        url('/parco.jpg') center center / cover no-repeat;
      background-color: var(--violet-deep);
    }

    .gateway-box {
      position: relative;
      width: min(400px, 100%);
      padding: 0;
      overflow: hidden;
      border: 1px solid var(--glass-border);
      border-radius: 28px;
      background:
        linear-gradient(135deg, rgba(255, 255, 255, .27), rgba(255, 255, 255, .08)),
        rgba(107, 63, 160, .38);
      box-shadow:
        0 25px 70px rgba(29, 10, 55, .45),
        inset 0 1px 0 rgba(255, 255, 255, .56),
        inset 0 -1px 0 rgba(46, 17, 73, .18);
      -webkit-backdrop-filter: blur(24px) saturate(150%);
      backdrop-filter: blur(24px) saturate(150%);
    }

    .gateway-box::before {
      content: "";
      position: absolute;
      z-index: 0;
      pointer-events: none;
      top: -55%;
      left: -25%;
      width: 100%;
      height: 100%;
      transform: rotate(-22deg);
      background: linear-gradient(110deg, transparent 22%, rgba(255, 255, 255, .28) 48%, transparent 72%);
    }

    .gateway-logo {
      position: relative;
      z-index: 1;
      display: block;
      width: 100%;
      height: auto;
      margin: 0;
      user-select: none;
      -webkit-user-drag: none;
    }

    .gateway-content {
      position: relative;
      z-index: 1;
      padding: 1.5rem 2rem 1.6rem;
    }

    .gateway-title {
      margin: 0;
      font-size: clamp(1.45rem, 5vw, 1.8rem);
      font-weight: 800;
      letter-spacing: -.03em;
      text-align: center;
      text-shadow: 0 1px 2px rgba(40, 15, 65, .25);
    }

    .gateway-subtitle {
      margin: .3rem 0 1.4rem;
      color: rgba(255, 255, 255, .86);
      font-size: .9rem;
      font-weight: 500;
      text-align: center;
    }

    .login-form-group { margin: 0 0 1rem; }

    .login-form-group label {
      display: block;
      margin: 0 0 .45rem;
      font-size: .84rem;
      font-weight: 750;
      text-shadow: 0 1px 1px rgba(40, 15, 65, .25);
    }

    .required { color: var(--yellow-light); }

    .login-form-group input {
      width: 100%;
      height: 48px;
      padding: 0 .95rem;
      color: var(--ink);
      font: inherit;
      font-size: .98rem;
      font-weight: 650;
      background: rgba(255, 255, 255, .78);
      border: 1px solid rgba(255, 255, 255, .72);
      border-radius: 14px;
      box-shadow: inset 0 1px 2px rgba(54, 21, 83, .11), 0 5px 15px rgba(39, 13, 65, .10);
      outline: none;
      transition: transform .16s ease, background .16s ease, border-color .16s ease, box-shadow .16s ease;
    }

    .login-form-group input:focus {
      background: rgba(255, 255, 255, .95);
      border-color: var(--yellow-light);
      box-shadow: 0 0 0 4px rgba(255, 224, 106, .29), inset 0 1px 2px rgba(54, 21, 83, .08), 0 8px 20px rgba(39, 13, 65, .16);
      transform: translateY(-1px);
    }

    .error-msg {
      display: flex;
      gap: .55rem;
      align-items: flex-start;
      margin: 0 0 1rem;
      padding: .78rem .9rem;
      color: #fff;
      font-size: .86rem;
      line-height: 1.4;
      background: rgba(151, 25, 54, .58);
      border: 1px solid rgba(255, 216, 224, .65);
      border-radius: 14px;
      box-shadow: inset 0 1px 0 rgba(255, 255, 255, .20);
    }

    .login-btn {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 100%;
      min-height: 50px;
      margin-top: 1.3rem;
      padding: .72rem 1rem;
      color: #332047;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 850;
      letter-spacing: .015em;
      cursor: pointer;
      background: linear-gradient(180deg, #ffe77c 0%, var(--yellow) 48%, #e7b726 100%);
      border: 1px solid rgba(255, 255, 255, .72);
      border-radius: 16px;
      box-shadow: 0 10px 22px rgba(37, 13, 58, .29), inset 0 1px 0 rgba(255, 255, 255, .70);
      transition: transform .16s ease, filter .16s ease, box-shadow .16s ease;
    }
    .login-btn:hover { filter: brightness(1.06); transform: translateY(-2px); box-shadow: 0 13px 28px rgba(37, 13, 58, .36), inset 0 1px 0 rgba(255, 255, 255, .78); }
    .login-btn:active { transform: translateY(0) scale(.985); }

    .gateway-footer {
      margin: 1.2rem 0 0;
      color: rgba(255, 255, 255, .72);
      font-size: .73rem;
      text-align: center;
    }

    @media (max-width: 520px) {
      .gateway-box { border-radius: 24px; }
      .gateway-content { padding: 1.3rem 1.2rem 1.4rem; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition-duration: .01ms !important; }
    }
  </style>
</head>
<body class="gateway-body">
  <main class="gateway-box">
    <img class="gateway-logo" src="/ciuco-logo-combo.png" alt="Ludicomix — Portale di gestione">

    <div class="gateway-content">
      <h1 class="gateway-title">Area riservata</h1>
      <p class="gateway-subtitle">Accedi con le tue credenziali</p>

      <form method="POST" action="/login" autocomplete="on">
        <div class="login-form-group">
          <label for="username">Username <span class="required">*</span></label>
          <input id="username" type="text" name="username" required autofocus autocomplete="username">
        </div>

        <div class="login-form-group">
          <label for="password">Password <span class="required">*</span></label>
          <input id="password" type="password" name="password" required autocomplete="current-password">
        </div>

        <% if (error) { %>
          <div class="error-msg" role="alert"><span aria-hidden="true">⚠</span><span><%= error %></span></div>
        <% } %>

        <button type="submit" class="login-btn">Entra nel portale</button>
      </form>

      <p class="gateway-footer">Ludicomix Empoli · Area riservata</p>
    </div>
  </main>
</body>
</html>
