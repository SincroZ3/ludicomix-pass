<!DOCTYPE html>
<html lang="it">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta name="theme-color" content="#5b2e8b">
  <title>Ludicomix Empoli — Accesso</title>
  <style>
    :root {
      --violet-deep: #3f2168;
      --violet-dark: #542b81;
      --violet: #6b3fa0;
      --violet-light: #9565c7;
      --yellow: #f5c842;
      --yellow-light: #ffe16f;
      --navy: #1e2d4e;
      --ink: #25143b;
    }
    * { box-sizing: border-box; }
    html, body { margin: 0; max-width: 100vw; overflow-x: hidden; }

    body.gateway-body {
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      min-height: 100dvh;
      padding: 20px;
      font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Arial, sans-serif;
      color: var(--ink);
      background:
        linear-gradient(135deg, rgba(63, 33, 104, .62) 0%, rgba(107, 63, 160, .38) 55%, rgba(30, 45, 78, .55) 100%),
        url('/ciuco-login.jpg') center center / cover no-repeat;
      background-color: var(--violet-deep);
    }

    .gateway-box {
      width: min(360px, 100%);
      padding: 38px 32px 30px;
      text-align: center;
      background: #fff;
      border-radius: 20px;
      border-top: 5px solid var(--yellow);
      box-shadow: 0 12px 40px rgba(29, 10, 55, .45);
    }

    .gateway-logo {
      display: block;
      width: 82%;
      max-width: 250px;
      height: auto;
      margin: 0 auto 16px;
      user-select: none;
      -webkit-user-drag: none;
    }

    .gateway-title {
      margin: 0 0 4px;
      font-size: 1.3rem;
      font-weight: 800;
      color: var(--violet-dark);
    }

    .gateway-subtitle {
      margin: 0 0 20px;
      font-size: .85rem;
      color: #777;
    }

    .gateway-form { text-align: left; }

    .gateway-form input {
      width: 100%;
      padding: 12px 4px;
      margin-bottom: 14px;
      border: none;
      border-bottom: 2px solid #ddd;
      border-radius: 0;
      background: transparent;
      color: var(--ink);
      font: inherit;
      font-size: .95rem;
      outline: none;
      transition: border-color .16s ease;
    }
    .gateway-form input::placeholder { color: #999; }
    .gateway-form input:focus { border-bottom-color: var(--violet); }

    .error-msg {
      margin: 0 0 12px;
      padding: .65rem .8rem;
      color: #8a1530;
      font-size: .88rem;
      line-height: 1.35;
      background: #fdebef;
      border-left: 4px solid #c0213f;
      border-radius: 8px;
      text-align: left;
    }

    .btn-violet {
      display: block;
      width: 100%;
      margin-top: 10px;
      padding: 13px 16px;
      color: #fff;
      font-family: inherit;
      font-size: 1rem;
      font-weight: 800;
      letter-spacing: .01em;
      cursor: pointer;
      background: linear-gradient(180deg, var(--violet) 0%, var(--violet-dark) 100%);
      border: none;
      border-bottom: 3px solid var(--yellow);
      border-radius: 10px;
      box-shadow: 0 6px 16px rgba(63, 33, 104, .35);
      transition: transform .16s ease, filter .16s ease, box-shadow .16s ease;
    }
    .btn-violet:hover { filter: brightness(1.1); transform: translateY(-1px); box-shadow: 0 9px 20px rgba(63, 33, 104, .42); }
    .btn-violet:active { transform: translateY(0); }

    .gateway-footer {
      margin: 18px 0 0;
      font-size: .73rem;
      color: #999;
    }

    @media (max-width: 520px) {
      .gateway-box { padding: 30px 22px 24px; }
    }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { transition-duration: .01ms !important; }
    }
  </style>
</head>
<body class="gateway-body">
  <main class="gateway-box">
    <img class="gateway-logo" src="/ciuco-logo-combo.png" alt="Ludicomix — Portale di gestione">
    <h1 class="gateway-title">Area riservata</h1>
    <p class="gateway-subtitle">Accedi con le tue credenziali</p>

    <% if (error) { %>
      <div class="error-msg" role="alert"><%= error %></div>
    <% } %>

    <form class="gateway-form" method="POST" action="/login" autocomplete="on">
      <input id="username" type="text" name="username" placeholder="Username" required autofocus autocomplete="username">
      <input id="password" type="password" name="password" placeholder="Password" required autocomplete="current-password">
      <button type="submit" class="btn-violet">Entra nel portale</button>
    </form>

    <p class="gateway-footer">Ludicomix Empoli · Area riservata</p>
  </main>
</body>
</html>
