<%- include('partials/header') %>
<nav class="breadcrumb-bar">Sei in: <a href="/home">Home</a> <span class="sep">›</span> <a href="/area-personale">Area Personale</a> <span class="sep">›</span> <strong>Profilo</strong></nav>
<h1 class="page-title">👤 Il Mio Profilo</h1>

<% if (saved === '1') { %><div class="alert alert-success">✅ Profilo aggiornato con successo.</div><% } %>
<% if (saved === 'firma') { %><div class="alert alert-success">✅ Firma caricata con successo.</div><% } %>
<% if (saved === 'firma-eliminata') { %><div class="alert alert-success">✅ Firma eliminata.</div><% } %>

<div class="alert alert-info">
  ℹ️ Questi dati vengono usati automaticamente per compilare il modulo PDF di autocertificazione
  ogni volta che invii una richiesta di rimborso spese — compilali una volta sola.
</div>

<div class="card" style="max-width:560px;">
  <div class="card-title">Dati anagrafici e bancari</div>
  <form method="POST" action="/area-personale/profilo">
    <label>Nome e cognome <span class="req">*</span>
      <input type="text" name="full_name" value="<%= user.full_name || '' %>" required maxlength="120">
    </label>
    <label style="margin-top:.9rem;">Luogo di nascita <span class="req">*</span>
      <input type="text" name="birth_place" value="<%= user.birth_place || '' %>" required maxlength="120">
    </label>
    <label style="margin-top:.9rem;">Data di nascita <span class="req">*</span>
      <input type="date" name="birth_date" value="<%= user.birth_date || '' %>" required>
    </label>
    <label style="margin-top:.9rem;">Codice Fiscale <span class="req">*</span>
      <input type="text" name="fiscal_code" value="<%= user.fiscal_code || '' %>" required maxlength="16" style="text-transform:uppercase;">
    </label>
    <label style="margin-top:.9rem;">IBAN (per il rimborso via bonifico)
      <input type="text" name="iban" value="<%= user.iban || '' %>" maxlength="34" style="text-transform:uppercase;">
    </label>
    <div style="margin-top:1.2rem;">
      <button type="submit" class="primary">💾 Salva profilo</button>
    </div>
  </form>
</div>

<div class="card" style="max-width:560px;">
  <div class="card-title">✍️ Firma digitale</div>
  <p class="help-text">Carica un'immagine della tua firma (PNG o JPG): verrà usata solo se scegli
  di firmare digitalmente al momento dell'invio di una richiesta di rimborso.</p>
  <% if (user.signature_file) { %>
    <div style="margin:1rem 0;padding:.75rem;border:1px solid var(--border-light);border-radius:8px;background:#fafafa;">
      <img src="/area-personale/profilo/firma/anteprima" alt="Firma salvata" style="max-height:80px;max-width:100%;">
    </div>
    <form method="POST" action="/area-personale/profilo/firma/elimina" onsubmit="return confirm('Eliminare la firma salvata?')">
      <button type="submit" class="btn-danger">🗑️ Elimina firma</button>
    </form>
  <% } else { %>
    <form method="POST" action="/area-personale/profilo/firma" enctype="multipart/form-data">
      <label>File firma <input type="file" name="signature" accept="image/png,image/jpeg" required></label>
      <div style="margin-top:.8rem;">
        <button type="submit" class="primary">⬆️ Carica firma</button>
      </div>
    </form>
  <% } %>
</div>

<%- include('partials/footer') %>
