<%- include('partials/header') %>
<nav class="breadcrumb-bar">Sei in: <a href="/home">Home</a> <span class="sep">›</span> <strong>Richieste Rimborsi</strong></nav>
<h1 class="page-title">💰 Richieste Rimborsi — Amministrazione Contabile</h1>

<div style="margin-bottom:1rem;">
  <a class="secondary" href="/area-personale/rimborsi/impostazioni-ente">🏛️ Dati Ente del Terzo Settore</a>
</div>

<div class="pill-tabs">
  <a class="pill-tab <%= statusFilter === 'tutte' ? 'active' : '' %>" href="/area-personale/rimborsi?stato=tutte">Tutte</a>
  <a class="pill-tab <%= statusFilter === 'in_attesa' ? 'active' : '' %>" href="/area-personale/rimborsi?stato=in_attesa">⏳ In attesa</a>
  <a class="pill-tab <%= statusFilter === 'approvata' ? 'active' : '' %>" href="/area-personale/rimborsi?stato=approvata">✅ Approvate</a>
  <a class="pill-tab <%= statusFilter === 'rifiutata' ? 'active' : '' %>" href="/area-personale/rimborsi?stato=rifiutata">❌ Rifiutate</a>
</div>

<div class="table-wrapper">
  <table>
    <thead><tr><th>#</th><th>Richiedente</th><th>Data</th><th>Periodo</th><th>Importo</th><th>Edizione</th><th>Stato</th><th>Revisore</th><th>Azioni</th></tr></thead>
    <tbody>
      <% requests.forEach(function(r){ %>
      <tr>
        <td>#<%= r.id %></td>
        <td><%= r.username %></td>
        <td><%= r.created_at %></td>
        <td><%= r.period_label || '—' %></td>
        <td>€ <%= r.total_amount.toFixed(2) %></td>
        <td><%= r.edition_name || '—' %></td>
        <td>
          <% if (r.status === 'in_attesa') { %><span class="chip" style="background:#fff8e1;color:#7d5a00;">⏳ In attesa</span>
          <% } else if (r.status === 'approvata') { %><span class="chip" style="background:#eafaf1;color:#1d6a39;">✅ Approvata</span>
          <% } else { %><span class="chip" style="background:#fef0f0;color:#922b21;">❌ Rifiutata</span><% } %>
        </td>
        <td><%= r.reviewer_name || '—' %></td>
        <td style="white-space:nowrap;">
          <button class="secondary" style="padding:.25rem .6rem;font-size:.72rem;" onclick="openDetailModal(<%= r.id %>)">🔍 Consulta</button>
          <a class="link-action" href="/area-personale/richieste-rimborso/<%= r.id %>/pdf?inline=1" target="_blank">📄 Visualizza PDF</a>
          <% if (r.status === 'in_attesa') { %>
            <button class="secondary" style="padding:.25rem .6rem;font-size:.72rem;" onclick="openReview(<%= r.id %>, 'approvata')">✅ Approva</button>
            <button class="btn-danger" style="padding:.25rem .6rem;font-size:.72rem;" onclick="openReview(<%= r.id %>, 'rifiutata')">❌ Rifiuta</button>
          <% } %>
        </td>
      </tr>
      <% }); %>
      <% if (!requests.length) { %><tr><td colspan="9" class="help-text">Nessuna richiesta trovata.</td></tr><% } %>
    </tbody>
  </table>
</div>

<!-- FIX bug #3: popup con i dettagli completi della richiesta -->
<div class="modal-overlay" id="modal-detail">
  <div class="modal" style="max-width:680px;">
    <div class="modal-header"><h2>🔍 Dettaglio richiesta</h2><button class="modal-close" onclick="document.getElementById('modal-detail').style.display='none'">✕</button></div>
    <div class="modal-body" id="detail-body" style="max-height:70vh;overflow-y:auto;">
      <p class="help-text">Caricamento...</p>
    </div>
  </div>
</div>

<div class="modal-overlay" id="modal-review">
  <div class="modal">
    <div class="modal-header" id="review-header"><h2 id="review-title">Valuta richiesta</h2><button class="modal-close" onclick="document.getElementById('modal-review').style.display='none'">✕</button></div>
    <form method="POST" id="review-form" action="">
      <div class="modal-body">
        <input type="hidden" name="status" id="review-status">
        <label>Note (opzionale, visibili al richiedente)
          <textarea name="review_notes" rows="3"></textarea>
        </label>
      </div>
      <div class="modal-actions" style="padding:0 1.2rem 1.2rem;">
        <button type="button" class="secondary" onclick="document.getElementById('modal-review').style.display='none'">Annulla</button>
        <button type="submit" class="primary" id="review-submit">Confirma</button>
      </div>
    </form>
  </div>
</div>

<script>
function escH(s){ if(!s) return ''; return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function openDetailModal(id){
  var body = document.getElementById('detail-body');
  body.innerHTML = '<p class="help-text">Caricamento...</p>';
  document.getElementById('modal-detail').style.display = 'flex';
  fetch('/api/area-personale/rimborsi/' + id)
    .then(function(r){ return r.json(); })
    .then(function(data){
      var req = data.request, expenses = data.expenses || [];
      var html = '<table style="width:100%;font-size:.88rem;margin-bottom:1rem;">' +
        '<tr><td style="color:var(--text-muted);width:140px;padding:.25rem 0;">Richiedente</td><td>' + escH(req.full_name || req.username) + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Nato a / il</td><td>' + escH(req.birth_place || '—') + (req.birth_date ? ' — ' + req.birth_date : '') + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Codice Fiscale</td><td>' + escH(req.fiscal_code || '—') + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Periodo</td><td>' + escH(req.period_label || '—') + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">IBAN</td><td>' + escH(req.iban || '—') + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Edizione</td><td>' + escH(req.edition_name || '—') + '</td></tr>' +
        '<tr><td style="color:var(--text-muted);padding:.25rem 0;">Totale</td><td><strong>€ ' + req.total_amount.toFixed(2) + '</strong></td></tr>' +
        '</table>';
      html += '<h3 style="margin:1rem 0 .5rem;">Spese incluse (' + expenses.length + ')</h3>';
      expenses.forEach(function(e){
        html += '<div style="margin-bottom:.9rem;padding:.6rem;border:1px solid var(--border-light);border-radius:8px;">';
        html += '<div style="display:flex;justify-content:space-between;font-size:.85rem;margin-bottom:.4rem;">' +
          '<strong>' + escH(e.description) + '</strong><span>' + e.expense_date + ' — € ' + e.amount.toFixed(2) + '</span></div>';
        if (e.receipts && e.receipts.length) {
          e.receipts.forEach(function(r){
            if (r.is_image) {
              html += '<img src="' + r.view_url + '" style="max-width:160px;max-height:120px;border-radius:6px;margin:.3rem .3rem 0 0;">';
            } else {
              html += '<a href="' + r.view_url + '" target="_blank" class="link-action" style="display:inline-block;margin-top:.3rem;">📎 ' + escH(r.original_name) + '</a>';
            }
          });
        } else {
          html += '<span class="help-text">Nessun allegato</span>';
        }
        html += '</div>';
      });
      document.getElementById('detail-body').innerHTML = html;
    })
    .catch(function(){ body.innerHTML = '<p class="help-text">Errore nel caricamento.</p>'; });
}

function openReview(id, status){
  document.getElementById('review-form').action = '/area-personale/rimborsi/' + id + '/stato';
  document.getElementById('review-status').value = status;
  var isApprove = status === 'approvata';
  document.getElementById('review-title').textContent = isApprove ? '✅ Approva richiesta #' + id : '❌ Rifiuta richiesta #' + id;
  document.getElementById('review-header').className = isApprove ? 'modal-header' : 'modal-header danger';
  document.getElementById('review-submit').textContent = isApprove ? 'Approva' : 'Rifiuta';
  document.getElementById('modal-review').style.display = 'flex';
}
</script>

<%- include('partials/footer') %>
